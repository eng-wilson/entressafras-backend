APP_NAME="Entressafras API"
DEBUG=false

# Google Earth Engine (umidade do solo SMAP). Projeto Cloud registrado no Earth Engine.
EE_PROJECT=
# Servidor (ex.: Railway): chave JSON da conta de serviço em base64 (ou JSON puro).
#   base64 -i chave.json | tr -d '\n' | pbcopy
EE_SERVICE_ACCOUNT_JSON=
# Alternativa: caminho do arquivo da chave. Sem nenhuma das duas, usa `earthengine authenticate`.
EE_SERVICE_ACCOUNT_KEY=

# Origens liberadas no CORS (JSON). Padrão: qualquer origem.
# CORS_ORIGINS='["https://meu-front.example"]'
